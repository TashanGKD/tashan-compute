# Development defaults are loopback-only. Copy to .env; never commit .env.
TCOMPUTE_ENV=development
TCOMPUTE_LISTEN_ADDRESS=127.0.0.1:8180
TCOMPUTE_PUBLIC_URL=http://127.0.0.1:8180

# Required in production. Values below are intentionally empty.
TCOMPUTE_DATABASE_URL=
TCOMPUTE_REDIS_URL=
TCOMPUTE_ACCESS_PRIVATE_KEY_FILE=
TCOMPUTE_ACCESS_PUBLIC_KEY_FILE=
TCOMPUTE_REFRESH_PEPPER_FILE=
TCOMPUTE_TRUSTED_PROXY_CIDRS=
TCOMPUTE_ALLOWED_ORIGINS=
